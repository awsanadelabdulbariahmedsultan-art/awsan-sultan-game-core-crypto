{
  "ProjectInfo": {
    "ProjectName": "Crypto-Game Engine Core",
    "Owner": "ENG AWSAN ADEL ABDULBARI AHMED SULTAN",
    "DeveloperID": "01010305468",
    "Version": "1.0.5-Automated-LiveOps"
  },
  "HardwareScalabilityProfiles": {
    "Profile_Ultra_RTX_Spark": {
      "TargetPlatforms": ["PC_Windows", "NVIDIA_Grace_Hopper_RTX_Spark"],
      "GraphicsPipeline": "Full_Path_Tracing",
      "Nvidia_DLSS_4": {
        "Enabled": true,
        "Mode": "Quality",
        "FrameGeneration": true,
        "RayReconstruction": true
      },
      "Nvidia_ACE_LocalAI": {
        "Enabled": true,
        "ExecutionModel": "Local_Tensor_Cores",
        "MaxContextTokens": 4096
      },
      "Nvidia_Reflex": {
        "Enabled": true,
        "Mode": "Boost"
      },
      "TargetFrameRate": 120
    },
    "Profile_Console_NextGen": {
      "TargetPlatforms": ["PlayStation_5", "Xbox_Series_X"],
      "GraphicsPipeline": "Hardware_Ray_Tracing",
      "Nvidia_DLSS_4": {
        "Enabled": false,
        "Comment": "Uses Console Native Temporal Upscaling"
      },
      "Nvidia_ACE_LocalAI": {
        "Enabled": true,
        "ExecutionModel": "Cloud_Hybrid_Fallback"
      },
      "Nvidia_Reflex": {
        "Enabled": false
      },
      "TargetFrameRate": 60
    },
    "Profile_Mobile_Universal": {
      "TargetPlatforms": ["Android_All_Versions", "iOS_All_Versions"],
      "GraphicsPipeline": "Mobile_Forward_Shaders",
      "FeaturesOverride": {
        "DisableRayTracing": true,
        "DisableDynamicShadows": true,
        "TextureQuality": "Optimized_Compressed",
        "ParticleSystemLimit": 150
      },
      "Nvidia_ACE_LocalAI": {
        "Enabled": true,
        "ExecutionModel": "Cloud_API_Bridge"
      },
      "TargetFrameRate": 60
    }
  },
  "AutomatedLiveOpsSync": {
    "AllowServerOverride": true,
    "CurrentConfigVersion": "v1.2-LiveOps",
    "AutoInjectContextToSubsystems": true
  }
}
